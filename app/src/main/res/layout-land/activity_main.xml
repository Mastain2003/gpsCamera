<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:fitsSystemWindows="true" android:background="#000000">
    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
        <androidx.camera.view.PreviewView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <com.visitcam.app.StampView android:id="@+id/stampView" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <com.visitcam.app.GridLines android:id="@+id/gridLines" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>
        <com.visitcam.app.LevelView android:id="@+id/levelView" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>
        <View android:id="@+id/focusRing" android:layout_width="68dp" android:layout_height="68dp" android:background="@drawable/focus_ring" android:visibility="invisible"/>
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_margin="6dp" android:textColor="#FFFFFF" android:textSize="11sp" android:shadowColor="#000000" android:shadowRadius="3"/>
        <TextView android:id="@+id/timer" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_margin="8dp" android:background="#99000000"
            android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:textColor="#FF5252" android:textSize="18sp"
            android:textStyle="bold" android:visibility="gone" android:text="00:00"/>
        <TextView android:id="@+id/countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:textColor="#FFFFFF" android:textSize="110sp" android:shadowColor="#000000"
            android:shadowRadius="8" android:visibility="gone"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="10dp" android:orientation="horizontal">
            <TextView android:id="@+id/btnZoom1" style="@style/ZoomBtn" android:text="1x"/>
            <TextView android:id="@+id/btnZoomX" style="@style/ZoomBtn" android:visibility="gone"/>
            <TextView android:id="@+id/btnZoom2" style="@style/ZoomBtn" android:text="2x"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/panelOptions" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="top" android:layout_margin="8dp" android:orientation="vertical"
            android:background="@drawable/panel_bg" android:padding="8dp" android:visibility="gone"/>
    </FrameLayout>
    <ScrollView android:layout_width="170dp" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingBottom="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/btnFlash" style="@style/TopIcon" android:text="⚡"/>
                <TextView android:id="@+id/btnOptions" style="@style/TopIcon" android:text="☰"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/btnFlip" style="@style/TopIcon" android:text="🔄"/>
                <TextView android:id="@+id/btnSettings" style="@style/TopIcon" android:text="⚙"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/tabPhoto" style="@style/TabText"/>
        <TextView android:id="@+id/tabVideo" style="@style/TabText"/>
        <TextView android:id="@+id/tabReports" style="@style/TabText"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="8dp"/>
            <TextView android:id="@+id/shutter" android:layout_width="76dp" android:layout_height="76dp" android:gravity="center" android:background="@drawable/shutter" android:textColor="#FFFFFF" android:textSize="28sp"/>
            <View android:layout_width="match_parent" android:layout_height="8dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
            <ImageView android:id="@+id/btnGallery" android:layout_width="48dp" android:layout_height="48dp" android:scaleType="centerCrop" android:background="@drawable/thumb_bg" android:clipToOutline="true"/>
            <TextView android:id="@+id/lblGallery" style="@style/CellLabel"/>
        </LinearLayout>
                <LinearLayout android:id="@+id/cellLocation" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍" android:textSize="28sp"/>
            <TextView android:id="@+id/lblLocation" style="@style/CellLabel"/>
        </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <LinearLayout android:id="@+id/cellStorage" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📁" android:textSize="28sp"/>
                <TextView android:id="@+id/lblStorage" style="@style/CellLabel"/>
            </LinearLayout>
            <TextView android:id="@+id/btnPause" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="⏸" android:textSize="32sp" android:textColor="#FFFFFF" android:visibility="invisible"/>
        </FrameLayout>
                <LinearLayout android:id="@+id/cellTemplates" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎨" android:textSize="28sp"/>
            <TextView android:id="@+id/lblTemplates" style="@style/CellLabel"/>
        </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
